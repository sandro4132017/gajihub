}

// ---------------------------------------------------------------------------
// BUKTI POTONG PAJAK - hasil UPLOAD MANUAL oleh Kasubag TU/PPABP (diunduh
// dari Web Gaji dulu, BELUM ada koneksi API ke sistem Kemenkeu). Pegawai
// cuma bisa lihat/download, TIDAK BISA upload sendiri (lihat role matrix
// PEGAWAI di CLAUDE.md).
// ---------------------------------------------------------------------------
model BuktiPotongPajak {
  id String @id @default(uuid())

  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  tahunPajak       Int     @map("tahun_pajak")
  nomorBuktiPotong String? @map("nomor_bukti_potong")
  fileUrl          String  @map("file_url")

  diunggahOlehId String @map("diunggah_oleh_id")
  diunggahOleh   User   @relation(fields: [diunggahOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pegawaiId, tahunPajak])
  @@map("bukti_potong_pajak")
