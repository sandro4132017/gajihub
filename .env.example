DATABASE_URL="postgresql://user:password@localhost:5432/gajihub_dev"

# Wajib diisi acak & panjang - generate dengan: openssl rand -hex 32
SESSION_SECRET="ganti-dengan-secret-acak"

# Set "true" HANYA kalau server ini diakses lewat HTTPS asli (langsung atau
# lewat reverse proxy yang terminate TLS). Biarkan kosong/false kalau masih
# HTTP biasa (mis. testing internal lewat VPN) - salah set "true" di sini
# tanpa HTTPS beneran bikin cookie sesi ditolak diam-diam oleh browser
# (user kelihatan berhasil login tapi langsung ke-logout lagi tiap pindah
# halaman). Lihat src/app/login/actions.ts.
COOKIE_SECURE="false"
