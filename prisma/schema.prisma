// ============================================================================
// GAJIHUB - INTEGRATION LAYER SCHEMA
// Sentralisasi Pengelolaan Belanja Pegawai - Kementerian Ketenagakerjaan
// ============================================================================
// Catatan desain:
// - Tabel ini adalah CACHE/MIRROR dari data sumber (SIAP, e-Presensi, e-Kinerja),
//   BUKAN source of truth. Source of truth tetap di aplikasi masing-masing.
// - Setiap tabel hasil tarikan data eksternal punya kolom `source_synced_at`
//   dan `source_system` untuk jejak dari mana & kapan data ditarik.
// - Semua perubahan status (approval, rekonsiliasi) tercatat di audit_trail,
//   jangan pernah overwrite tanpa jejak.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PEGAWAI - mirror data pokok dari SIAP
// ---------------------------------------------------------------------------
model Pegawai {
  id            String    @id @default(uuid())
  nip           String    @unique
  nama          String
  unitKerja     String    @map("unit_kerja")
  satuanKerja   String    @map("satuan_kerja") // untuk filter per satker saat pilot
  statusPegawai String    @map("status_pegawai") // AKTIF, CUTI, MUTASI, PENSIUN, dst
  jabatan       String?
  golongan      String?
  // Dipakai buat lookup tukinPokokKelasJabatan (src/business-logic/tarifTukinPokok.ts).
  // Sebelumnya cuma ada di PegawaiRecord adapter (tidak persisten) - sekarang
  // dipersist karena ada sumber data pegawai asli (basis data pegawai) yang
  // punya kolom GRADE ini.
  kelasJabatan  Int?      @map("kelas_jabatan")
  tmtSkTerakhir DateTime? @map("tmt_sk_terakhir")

  sourceSystem   String   @default("SIAP") @map("source_system")
  sourceSyncedAt DateTime @map("source_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  presensi          PresensiHarian[]
  predikatKinerja   PredikatKinerja[]
  tukinCalc         TukinCalculation[]
  uangMakan         UangMakan[]
  uangLembur        UangLembur[]
  banding           Banding[]
  skKgb             SkKgb[]
  skHukumanDisiplin SkHukumanDisiplin[]
  buktiPotongPajak  BuktiPotongPajak[]
  gajiInduk         GajiInduk[]
  rekapPresensi     RekapPresensiPeriode[]
  koreksiPresensi   KoreksiPresensiHarian[]
  rekening          RekeningPegawai[]
  identitasWebGaji  IdentitasWebGaji?

  @@index([satuanKerja])
  @@index([statusPegawai])
  @@map("pegawai")
}

// ---------------------------------------------------------------------------
// PRESENSI HARIAN - mirror dari e-Presensi
// ---------------------------------------------------------------------------
model PresensiHarian {
  id        String  @id @default(uuid())
  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  tanggal                 DateTime
  jamMasuk                DateTime? @map("jam_masuk")
  jamKeluar               DateTime? @map("jam_keluar")
  // HADIR/WFO/WFH/WFA/TERLAMBAT = berhak uang makan (SBM 2026 item 22.1)
  // DIKLAT/DINAS_LUAR = bekerja, TAPI tidak berhak uang makan (konsumsi sudah
  // ditanggung kegiatan/perjalanan dinasnya)
  // ALPHA/TIDAK_PRESENSI/IZIN/SAKIT/CUTI = tidak berhak
  statusKehadiran         String    @map("status_kehadiran")
  // Pasal 13 ayat (3) Permenaker 15/2024 menyebut TIGA pelanggaran dengan
  // tarif sama (0,01%/menit): terlambat hadir, pulang cepat, dan
  // meninggalkan kantor. Disimpan terpisah - bukan karena tarifnya beda,
  // tapi supaya bisa dijelaskan ke pegawai/auditor menitnya dari mana.
  // Sebelumnya cuma ada menit_terlambat, jadi dua jenis lain tidak punya
  // tempat dan terpaksa dititipkan ke keterlambatan.
  menitTerlambat          Int       @default(0) @map("menit_terlambat")
  menitPulangCepat        Int       @default(0) @map("menit_pulang_cepat")
  menitMeninggalkanKantor Int       @default(0) @map("menit_meninggalkan_kantor")
  // Pasal 13 ayat (4) - potongan 3% karena tidak ikut upacara bendera tanpa
  // alasan sah. Ditandai per HARI presensi karena upacara memang terjadi di
  // tanggal tertentu (umumnya tanggal 17).
  tidakIkutUpacara        Boolean   @default(false) @map("tidak_ikut_upacara")
  // Jam lembur HARI INI. Sudah lama dihitung per hari oleh
  // rekapDariLaporanPdf(), tapi dulu cuma totalnya yang disimpan (di
  // RekapPresensiPeriode). Dipakai export ADK Uang Lembur, yang formatnya
  // memang per tanggal - total sebulan tidak bisa dipecah balik jadi
  // tanggal-tanggal tanpa mengarang datanya.
  //
  // Hari kerja vs hari libur TIDAK disimpan terpisah di sini: tanggalnya
  // sudah ada di baris ini, jadi klasifikasinya bisa diturunkan ulang kapan
  // pun. Menyimpannya dua kali cuma menciptakan kemungkinan keduanya beda.
  jamLembur               Float     @default(0) @map("jam_lembur")

  sourceSystem   String   @default("e-Presensi") @map("source_system")
  sourceSyncedAt DateTime @map("source_synced_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pegawaiId, tanggal])
  @@index([tanggal])
  @@map("presensi_harian")
}

// ---------------------------------------------------------------------------
// PREDIKAT KINERJA - dari e-Kinerja BKN (via upload manual / API, lihat adapter)
// ---------------------------------------------------------------------------
model PredikatKinerja {
  id        String  @id @default(uuid())
  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  periodeBulan Int    @map("periode_bulan")
  periodeTahun Int    @map("periode_tahun")
  predikat     String // SANGAT BAIK, BAIK, CUKUP, KURANG, SANGAT KURANG
  nilaiAngka   Float  @map("nilai_angka") // konversi predikat ke skala 0-100

  // Dua rating penyusun predikat, apa adanya dari kolom "Rating Hasil Kerja"
  // & "Rating Perilaku Kerja" di file Rekap Penilaian e-Kinerja BKN (mis.
  // "Diatas Ekspektasi"). Sebelumnya dibaca parser lalu DIBUANG.
  //
  // TIDAK dipakai menghitung tukin - yang menentukan cuma `predikat` akhir
  // (Kepsekjen 82/2025). Ini murni informasi, supaya rincian di aplikasi
  // sebanding dengan rekap Excel manual yang menampilkan keduanya.
  //
  // Nullable: baris lama tidak punya nilainya, dan input manual per orang
  // (actionsKelola.ts) memang cuma meminta predikat akhir.
  hasilKerja    String? @map("hasil_kerja")
  perilakuKerja String? @map("perilaku_kerja")

  // Unit PENILAI, dari baris kedua kepala file Rekap Penilaian e-Kinerja BKN
  // (mis. "Subbagian Tata Usaha"). Satu satuan kerja bisa dinilai oleh lebih
  // dari satu penilai, masing-masing mengekspor filenya sendiri berisi orang
  // yang berbeda - kolom ini yang membuat "file mana saja yang sudah masuk"
  // bisa dilihat, bukan cuma "berapa orang yang sudah punya predikat".
  //
  // PERINGATAN LAMA YANG TETAP BERLAKU: ini BUKAN `Pegawai.satuanKerja` dan
  // TIDAK BOLEH dipakai untuk scoping kewenangan. Nilainya nama sub-unit
  // penilaian yang tidak selalu cocok dengan satuan kerja pegawainya.
  // null = predikat diinput manual, bukan dari file BKN.
  unitPenilaian String? @map("unit_penilaian")

  sourceSystem   String   @default("e-Kinerja BKN") @map("source_system")
  sourceSyncedAt DateTime @map("source_synced_at")
  // Karena akses API BKN masih informal (lihat CLAUDE.md), field ini menandai
  // apakah data masuk lewat upload manual sesuai workaround, atau via API resmi.
  inputMethod    String   @default("MANUAL_UPLOAD") @map("input_method") // MANUAL_UPLOAD | API

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pegawaiId, periodeBulan, periodeTahun])
  @@map("predikat_kinerja")
}

// ---------------------------------------------------------------------------
// TUKIN CALCULATION - hasil kalkulasi business logic engine
// ---------------------------------------------------------------------------
model TukinCalculation {
  id        String  @id @default(uuid())
  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  periodeBulan Int @map("periode_bulan")
  periodeTahun Int @map("periode_tahun")

  komponenKehadiran Float @map("komponen_kehadiran") // hasil 30%
  komponenKinerja   Float @map("komponen_kinerja") // hasil 70%
  tukinPokok        Float @map("tukin_pokok")
  potonganPph       Float @default(0) @map("potongan_pph")
  tukinBersih       Float @map("tukin_bersih")

  status         String  @default("DRAFT") // DRAFT, COCOK, SELISIH, SANGGAH, APPROVED, DIKIRIM
  catatanAnomali String? @map("catatan_anomali")

  calculatedAt DateTime  @default(now()) @map("calculated_at")
  approvedAt   DateTime? @map("approved_at")
  approvedBy   String?   @map("approved_by")

  @@unique([pegawaiId, periodeBulan, periodeTahun])
  @@index([status])
  @@map("tukin_calculation")
}

model UangMakan {
  id        String  @id @default(uuid())
  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  periodeBulan      Int   @map("periode_bulan")
  periodeTahun      Int   @map("periode_tahun")
  jumlahHariKerja   Int   @map("jumlah_hari_kerja")
  jumlahHariHadir   Int   @map("jumlah_hari_hadir")
  // Hari yang BENAR-BENAR dibayar (WFO + WFH/WFA). Bisa lebih kecil dari
  // jumlahHariHadir kalau ada hari diklat/dinas luar - keduanya hadir tapi
  // tidak berhak uang makan. Disimpan supaya selisihnya bisa dijelaskan.
  jumlahHariDibayar Int   @default(0) @map("jumlah_hari_dibayar")
  tarifHarian       Float @map("tarif_harian") // SBM 2026 item 22.1, per golongan
  totalUangMakan    Float @map("total_uang_makan")

  status         String    @default("DRAFT")
  catatanAnomali String?   @map("catatan_anomali")
  calculatedAt   DateTime  @default(now()) @map("calculated_at")
  approvedAt     DateTime? @map("approved_at")
  approvedBy     String?   @map("approved_by")

  @@unique([pegawaiId, periodeBulan, periodeTahun])
  @@map("uang_makan")
}

model UangLembur {
  id        String  @id @default(uuid())
  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  periodeBulan            Int   @map("periode_bulan")
  periodeTahun            Int   @map("periode_tahun")
  totalJamLembur          Float @map("total_jam_lembur")
  tarifPerJam             Float @map("tarif_per_jam") // SBM 2026 item 23.1, per golongan
  // Pendapatan lembur = uang lembur (per JAM) + uang makan lembur (per HARI).
  // Disimpan terpisah supaya slip gaji & ADK bisa merincinya, dan supaya
  // jelas bahwa keduanya tarif & satuannya beda (SBM item 23.1 vs 23.2).
  jumlahHariMakanLembur   Int   @default(0) @map("jumlah_hari_makan_lembur") // hari dengan lembur >= 2 jam berturut-turut
  tarifMakanLemburPerHari Float @default(0) @map("tarif_makan_lembur_per_hari") // SBM item 23.2
  jamLemburHariKerja      Float @default(0) @map("jam_lembur_hari_kerja")
  jamLemburHariLibur      Float @default(0) @map("jam_lembur_hari_libur") // dibayar 2x tarif
  uangLembur              Float @default(0) @map("uang_lembur")
  uangMakanLembur         Float @default(0) @map("uang_makan_lembur")
  totalUangLembur         Float @map("total_uang_lembur") // uangLembur + uangMakanLembur

  status         String    @default("DRAFT")
  catatanAnomali String?   @map("catatan_anomali")
  calculatedAt   DateTime  @default(now()) @map("calculated_at")
  approvedAt     DateTime? @map("approved_at")
  approvedBy     String?   @map("approved_by")

  @@unique([pegawaiId, periodeBulan, periodeTahun])
  @@map("uang_lembur")
}

// ---------------------------------------------------------------------------
// APPROVAL LOG - approval digital berjenjang, pengganti nota dinas fisik.
// Tabel generik/reusable, BUKAN cuma buat approval kalkulasi payroll - juga
// dipakai buat histori verifikasi berjenjang Banding, SK KGB, dan SK Hukuman
// Disiplin (referensiId = id baris model masing-masing). Nilai referensiTipe
// yang dipakai saat ini:
//   - TUKIN, UANG_MAKAN, UANG_LEMBUR      -> approval kalkulasi payroll
//   - BANDING                              -> jenjang 1 = verifikasi Kasubag
//                                             TU, jenjang 2 = approval final
//                                             OSDMA (lihat model Banding)
//   - SK_KGB, SK_HUKUMAN_DISIPLIN          -> approval tunggal (jenjang 1)
//                                             oleh OSDMA (lihat model
//                                             masing-masing untuk asumsi
//                                             yang masih TODO(confirm))
// ---------------------------------------------------------------------------
model ApprovalLog {
  id            String @id @default(uuid())
  referensiTipe String @map("referensi_tipe")
  referensiId   String @map("referensi_id")

  approverNip     String @map("approver_nip")
  approverNama    String @map("approver_nama")
  approverJabatan String @map("approver_jabatan")
  jenjang         Int // urutan approval berjenjang (1, 2, dst)

  keputusan String // SETUJU, TOLAK, REVISI
  catatan   String?

  timestampAksi DateTime @default(now()) @map("timestamp_aksi")

  @@index([referensiTipe, referensiId])
  @@map("approval_log")
}

// ---------------------------------------------------------------------------
// AUDIT TRAIL - jejak audit lengkap untuk semua perubahan data penting
// ---------------------------------------------------------------------------
model AuditTrail {
  id          String   @id @default(uuid())
  entitas     String // nama tabel/entitas yang berubah
  entitasId   String   @map("entitas_id")
  aksi        String // CREATE, UPDATE, DELETE, SYNC, APPROVE
  aktor       String // NIP atau "SYSTEM" untuk proses otomatis

  /// Satuan kerja yang DIKENAI aksi ini - bukan satuan kerja aktornya.
  ///
  /// Dipakai men-scope panel Notifikasi & Aktivitas: orang Biro Keuangan hanya
  /// melihat yang menyangkut Biro Keuangan. Diisi SAAT MENULIS karena saat itu
  /// kodenya memang tahu unitnya; menurunkannya saat dibaca MUSTAHIL - format
  /// `entitasId` beda-beda per jenis entitas (ada yang berisi nama satker, ada
  /// yang "NIP-tanggal", ada yang UUID), jadi menebaknya berisiko menampilkan
  /// aktivitas unit lain ke orang yang tidak berhak.
  ///
  /// NULL = memang lintas satker / tidak terikat unit (mis. penanda kendala
  /// e-Presensi se-kementerian, kalender hari libur, perubahan role akun).
  /// Baris NULL hanya terlihat oleh role lintas unit.
  satuanKerja String? @map("satuan_kerja")

  dataSebelum Json?    @map("data_sebelum")
  dataSesudah Json?    @map("data_sesudah")
  timestamp   DateTime @default(now())

  @@index([entitas, entitasId])
  @@index([timestamp])
  @@index([satuanKerja, timestamp])
  @@map("audit_trail")
}

// ---------------------------------------------------------------------------
// RECONCILIATION STATUS - workflow DRAFT -> COCOK/SELISIH/SANGGAH
//
// Status "SANGGAH" di sini terhubung otomatis ke ada/tidaknya baris Banding
// yang masih terbuka untuk pegawai+periode yang sama - lihat
// `ajukanBandingAction` (src/app/saya/actions.ts) yang meng-upsert baris ini
// jadi "SANGGAH" tiap kali Banding baru diajukan.
// ---------------------------------------------------------------------------
model ReconciliationStatus {
  id           String @id @default(uuid())
  pegawaiId    String @map("pegawai_id")
  periodeBulan Int    @map("periode_bulan")
  periodeTahun Int    @map("periode_tahun")

  status        String @default("DRAFT") // DRAFT, COCOK, SELISIH, SANGGAH, DIPUTUSKAN
  detailSelisih Json?  @map("detail_selisih") // field mana yang beda & nilai dari masing-masing sumber

  // NOTE: durasi window verifikasi & aturan "hold vs koreksi siklus berikutnya"
  // masih jadi open policy decision (lihat CLAUDE.md) - field di bawah
  // disiapkan tapi behavior-nya menunggu keputusan kebijakan.
  windowVerifikasiBerakhir DateTime? @map("window_verifikasi_berakhir")
  keputusanAkhir           String?   @map("keputusan_akhir") // HOLD_PEMBAYARAN | KOREKSI_SIKLUS_BERIKUTNYA

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pegawaiId, periodeBulan, periodeTahun])
  @@index([status])
  @@map("reconciliation_status")
}

// ---------------------------------------------------------------------------
// AKUN APPROVER - DEPRECATED. Login approver lama, SUDAH TIDAK DIPAKAI oleh
// halaman /login lagi - digantikan login berbasis model User (nip sebagai
// username & password sekaligus, lihat src/auth/session.ts dan
// src/app/login/actions.ts). Tabel ini SENGAJA belum dihapus/di-drop supaya
// tidak ada migrasi destruktif tanpa perlu, tapi JANGAN dikembangkan lebih
// lanjut atau dipakai di kode baru manapun.
// ---------------------------------------------------------------------------
model AkunApprover {
  id           String   @id @default(uuid())
  nip          String   @unique
  nama         String
  jabatan      String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("akun_approver")
}

// ---------------------------------------------------------------------------
// ROLE & USER - sistem role/otorisasi (lihat CLAUDE.md bagian "Role matrix"
// untuk daftar hak akses lengkap per role - versi simulasi/demo lengkap,
// 6 role).
//
// TODO(confirm) BESAR: model ini SENGAJA terpisah dari AkunApprover di atas.
// AkunApprover = login sementara (NIP + password) khusus approver Tukin/
// Uang Makan/Uang Lembur, dibuat sebelum User/Role ini ada. User di sini
// murni soal SIAPA-BOLEH-APA (otorisasi), belum tersambung ke mekanisme
// login manapun. Begitu SSO SIAP tersedia (atau kalau AkunApprover mau
// dipertahankan lebih lama), kedua model ini KEMUNGKINAN BESAR perlu
// disatukan supaya satu login = satu identitas + satu role - jangan biarkan
// dua sistem akun berjalan paralel selamanya. Belum diputuskan caranya,
// jangan asumsikan salah satu bakal "menang" begitu saja.
//
// TODO(confirm) - PERUBAHAN ENUM: sebelumnya ada 7 role (termasuk ITJEN
// auditor terpisah, BIRO_OSDMA, ADMIN_SISTEM). Untuk kebutuhan simulasi/demo
// stakeholder saat ini di-enumerate ulang jadi 6 role di bawah - ITJEN
// DIHAPUS dari cakupan simulasi ini (bukan diputuskan tidak perlu secara
// permanen, cuma belum masuk skenario demo ini), BIRO_OSDMA -> OSDMA dan
// ADMIN_SISTEM -> ADMIN cuma perubahan penamaan MENUJU role ADMIN yang
// cakupannya SENGAJA diperluas jauh melebihi ADMIN_SISTEM lama (lihat
// catatan "BUKAN DESAIN FINAL" di bawah) - kalau ITJEN/auditor read-only
// dibutuhkan lagi nanti, tinggal ditambahkan lagi ke enum ini.
enum Role {
  PEGAWAI // self-service, semua role lain otomatis punya privilege ini juga
  KASUBAG_TU // Kasubag TU / Bagian Kepegawaian Unit Kerja - verifikator tingkat satker
  OSDMA // Biro OSDMA - approval final Banding & SK KGB, update SK pegawai
  PPABP // Tim PPABP Rokeu - validasi lintas unit, export ADK, dashboard kementerian
  PIMPINAN // dashboard kementerian read-only (sama dengan PPABP, tanpa approval/ubah data)

  // TODO(confirm) - BUKAN DESAIN FINAL UNTUK PRODUCTION: role ADMIN di bawah
  // ini SENGAJA diberi akses PENUH ke SEMUA fitur (privilege seluruh role di
  // atas + konfigurasi sistem + eksekusi final perubahan role), supaya SATU
  // akun bisa dipakai menunjukkan SELURUH alur ke stakeholder dalam satu
  // sesi. Ini BERTENTANGAN dengan prinsip pemisahan kewenangan teknis vs
  // bisnis yang sudah didokumentasikan (lihat catatan lama soal
  // ADMIN_SISTEM yang SENGAJA TIDAK BOLEH lihat data payroll). SEBELUM
  // production, role ini WAJIB dipecah lagi jadi System Admin (akses teknis
  // saja: config, monitoring, eksekusi role assignment) + role bisnis
  // terpisah - JANGAN biarkan satu akun super-admin ini jadi permanen cuma
  // karena praktis buat demo.
  ADMIN
}

// TODO(legal-confirm): belum diputuskan apakah role di-assign OTOMATIS dari
// jabatan/eselon di SIAP, atau MANUAL oleh Admin. Untuk sekarang role diisi
// manual/lewat seed script (mirip pola AkunApprover) - JANGAN bikin logic
// auto-mapping jabatan->role tanpa konfirmasi ke Biro OSDMA, karena pemetaan
// jabatan struktural ke role sistem ini bisa banyak pengecualian (misal
// siapa yang jadi Kasubag TU kalau posisinya kosong/Plt.).
model User {
  id   String @id @default(uuid())
  nip  String @unique
  nama String
  role Role

  // WAJIB diisi untuk role KASUBAG_TU (scoping: cuma boleh lihat/approve
  // pegawai & banding di satuan kerja ini). Untuk role lain:
  // - PEGAWAI: scoping akses ke data sendiri dilakukan lewat relasi NIP ke
  //   Pegawai, BUKAN lewat field ini - biarkan NULL.
  // - PPABP: TIDAK DIPAKAI sama sekali. PPABP selalu berwenang LINTAS SEMUA
  //   satuan kerja (asumsi pilot: tim PPABP pusat).
  //   DULU field ini juga dipakai buat men-scope PPABP kalau kebetulan
  //   terisi, dengan niat "tidak perlu migrasi kalau nanti di-scale per
  //   satker". Itu SUDAH DICABUT (lihat cekPpabp di src/auth/permissions.ts):
  //   sejak ada multi-role, satu akun bisa memegang KASUBAG_TU + PPABP
  //   sekaligus, dan kolom ini WAJIB terisi demi KASUBAG_TU - akibatnya akun
  //   itu diam-diam kehilangan jangkauan lintas unit begitu dia berperan
  //   sebagai PPABP.
  //   TODO(confirm): kalau "PPABP per satker" jadi diputuskan, JANGAN numpang
  //   kolom ini lagi - butuh kolom sendiri (mis. satuan_kerja_ppabp) atau
  //   tabel penugasan terpisah, dan itu memang perlu migrasi.
  // - OSDMA, PIMPINAN, ADMIN: kewenangan lintas satker, biarkan NULL.
  satuanKerja String? @map("satuan_kerja")

  // Role TAMBAHAN yang boleh dipakai akun ini lewat menu "Ganti role" di
  // tombol akun (sidebar). Kosong = akun single-role seperti sebelumnya.
  //
  // KENAPA ADA: kebutuhan TESTING/DEMO - satu orang penguji bisa mencoba
  // alur lintas role (mis. ajukan SK KGB sebagai Kasubag TU, lalu approve
  // sebagai OSDMA) tanpa logout-login berkali-kali pakai NIP orang lain.
  //
  // Yang PENTING dipahami soal semantiknya:
  // - Ini BUKAN "role gabungan": pada satu waktu akun tetap berperan
  //   sebagai SATU role aktif saja (disimpan di cookie sesi). Otorisasi
  //   tetap dievaluasi terhadap satu role itu lewat src/auth/permissions.ts
  //   - tidak ada fungsi izin yang meng-OR-kan beberapa role sekaligus.
  // - `role` di atas tetap role UTAMA/default (dipakai waktu login).
  // - `satuanKerja` TETAP SATU untuk semua role akun ini - jadi kalau
  //   KASUBAG_TU ada di daftar role (utama maupun tambahan), field itu
  //   WAJIB diisi, kalau tidak akun jadi "buta unit" begitu ganti ke role
  //   Kasubag TU (gap yang sama dengan UsulanPerubahanRole, lihat CLAUDE.md).
  //
  // TODO(confirm): ini fitur untuk kemudahan TESTING, BUKAN desain final
  // production. Satu orang memegang beberapa kewenangan sekaligus
  // bertentangan dengan pemisahan kewenangan (mis. pengaju SK KGB tidak
  // seharusnya juga jadi approver-nya) - sebelum production, putuskan
  // apakah kolom ini dihapus, atau dibatasi (mis. cuma boleh di lingkungan
  // non-production / kombinasi role tertentu saja). Jejak pergantian role
  // TIDAK dicatat ke AuditTrail (bukan perubahan data, cuma sudut pandang),
  // tapi setiap aksi tetap tercatat atas NIP yang sama - jadi kalau kolom
  // ini dipakai di production, log approval TIDAK akan menunjukkan "role
  // apa yang sedang dipakai" waktu aksi itu dilakukan.
  rolesTambahan Role[] @map("roles_tambahan")

  aktif Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bandingDiajukan          Banding[]
  buktiDiunggah            BuktiDukung[]
  skKgbDiajukan            SkKgb[]                 @relation("SkKgbDiajukanOleh")
  skHukdisDiajukan         SkHukumanDisiplin[]     @relation("SkHukdisDiajukanOleh")
  anggaranDiunggah         AnggaranRealisasi[]
  buktiPotongPajakDiunggah BuktiPotongPajak[]
  gajiIndukDiunggah        GajiInduk[]
  rekapPresensiDiunggah    RekapPresensiPeriode[]
  rekeningDiunggah         RekeningPegawai[]
  identitasWebGajiDiunggah IdentitasWebGaji[]
  kendalaEpresensiDitandai KendalaEpresensi[]
  koreksiPresensiDibuat    KoreksiPresensiHarian[]
  hariLiburDitetapkan      HariLiburNasional[]
  usulanRoleDiajukan       UsulanPerubahanRole[]   @relation("UsulanRoleDiajukanOleh")
  usulanRoleDiputuskan     UsulanPerubahanRole[]   @relation("UsulanRoleDiputuskanOleh")
  UsulanPerubahanRole      UsulanPerubahanRole[]

  @@index([role])
  @@index([satuanKerja])
  @@map("app_user")
}

// ---------------------------------------------------------------------------
// BANDING (dulu bernama "Sanggahan") - pegawai membantah hasil kalkulasi
// Tukin/Uang Makan/Uang Lembur yang menurutnya tidak sesuai.
//
// CATATAN DESAIN PENTING:
// - Referensi ke kalkulasi yang dibanding pakai pola GENERIK yang sama
//   dengan ApprovalLog (referensiTipe + referensiId), BUKAN foreign key
//   terpisah per TukinCalculation/UangMakan/UangLembur - supaya konsisten
//   dan tidak perlu 3 kolom nullable berbeda.
// - Alur verifikasi SEKARANG SUDAH DITETAPKAN (untuk kebutuhan simulasi ini
//   - lihat TODO di bawah): 2 jenjang tetap, DIAJUKAN -> jenjang 1 verifikasi
//   Kasubag TU -> jenjang 2 approval final OSDMA. Histori tiap jenjang
//   DICATAT DI ApprovalLog, dengan referensiTipe = "BANDING" dan
//   referensiId = id baris Banding ini - pola & alasan yang sama dengan
//   approval Tukin/Uang Makan/Uang Lembur (reuse evaluasiApproval), BUKAN
//   kolom verifikator terpisah di model ini.
//   TODO(confirm): penetapan "2 jenjang tetap, Kasubag TU lalu OSDMA final"
//   ini datang dari spesifikasi simulasi/demo, BELUM tentu kebijakan resmi
//   final - konfirmasi ke Biro OSDMA/Hukum sebelum dipakai ke production.
// - Sudah terhubung ke ReconciliationStatus: lihat catatan di model itu.
// ---------------------------------------------------------------------------
model Banding {
  id String @id @default(uuid())

  pegawaiId    String  @map("pegawai_id")
  pegawai      Pegawai @relation(fields: [pegawaiId], references: [id])
  periodeBulan Int     @map("periode_bulan")
  periodeTahun Int     @map("periode_tahun")

  referensiTipe String @map("referensi_tipe") // TUKIN, UANG_MAKAN, UANG_LEMBUR
  referensiId   String @map("referensi_id")

  // Pengaju HARUS role PEGAWAI dan (asumsi saat ini) selalu pegawai yang
  // sama dengan `pegawaiId` di atas - banding diri sendiri, bukan
  // diwakilkan. TODO(confirm) kalau ternyata ada skenario pengajuan
  // terwakilkan (misal pegawai cuti panjang/sakit berat).
  pengajuId String @map("pengaju_id")
  pengaju   User   @relation(fields: [pengajuId], references: [id])

  alasan String

  // DIAJUKAN -> MENUNGGU_APPROVAL_FINAL (jenjang 1/Kasubag TU sudah SETUJU)
  // -> DISETUJUI | DITOLAK (jenjang 2/OSDMA final). Lihat TODO(confirm) di
  // atas soal status alur 2-jenjang ini.
  status String @default("DIAJUKAN")

  // TODO(confirm): SLA batas waktu banding (berapa hari sejak data
  // kalkulasi tayang) belum ditentukan kebijakannya. Isi field ini dari
  // konstanta yang jelas ditandai TODO(confirm) di kode - JANGAN hardcode
  // angka final tanpa konfirmasi. Konsepnya sama dengan
  // ReconciliationStatus.windowVerifikasiBerakhir, cuma di level banding
  // individual - kemungkinan besar diisi dari sumber SLA yang sama nanti.
  batasWaktuVerifikasi DateTime? @map("batas_waktu_verifikasi")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buktiDukung BuktiDukung[]

  @@index([pegawaiId])
  @@index([referensiTipe, referensiId])
  @@index([status])
  @@map("banding")
}

// ---------------------------------------------------------------------------
// BUKTI DUKUNG (dulu bernama "BuktiPendukungUpload") - lampiran dokumen (SK,
// surat sakit, surat cuti/izin, dll) yang diunggah pegawai untuk mendukung
// bandingnya.
//
// TODO(confirm): mekanisme penyimpanan file BELUM diputuskan (local disk,
// object storage/S3-compatible, atau lewat modul lain) - `fileUrl` di bawah
// cuma referensi string generik, bukan implementasi storage tertentu.
// Jangan asumsikan salah satu mekanisme sebelum dikonfirmasi (terutama
// terkait kebijakan retensi dokumen kepegawaian ke Biro Hukum/OSDMA).
// ---------------------------------------------------------------------------
model BuktiDukung {
  id String @id @default(uuid())

  bandingId String  @map("banding_id")
  banding   Banding @relation(fields: [bandingId], references: [id])

  jenisDokumen String @map("jenis_dokumen") // SK, SURAT_SAKIT, SURAT_CUTI_IZIN, LAINNYA
  namaFile     String @map("nama_file")
  fileUrl      String @map("file_url")
  ukuranBita   Int?   @map("ukuran_bita")

  diunggahOlehId String @map("diunggah_oleh_id")
  diunggahOleh   User   @relation(fields: [diunggahOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bandingId])
  @@map("bukti_dukung")
}

// ---------------------------------------------------------------------------
// SK KGB - pengajuan Kenaikan Gaji Berkala oleh Kasubag TU, approval final
// OSDMA. Approval TUNGGAL (jenjang 1 saja) dicatat di ApprovalLog dengan
// referensiTipe = "SK_KGB".
//
// TODO(confirm): sistem ini TIDAK punya tabel skala gaji pokok PNS (di luar
// cakupan "don't replace, integrate" - itu domain Web Gaji/BKN). Field
// golonganBaru di bawah SENGAJA disederhanakan jadi representasi golongan
// saja untuk kebutuhan simulasi - belum menangani masa-kerja-golongan/step
// increment yang sebenarnya jadi inti KGB. `appliedAt`/`appliedBy` diisi
// SETELAH disetujui OSDMA DAN service layer benar-benar meng-update
// `Pegawai.golongan` (belum diimplementasikan di langkah ini - schema-only).
// ---------------------------------------------------------------------------
model SkKgb {
  id String @id @default(uuid())

  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  nomorSk   String   @map("nomor_sk")
  tanggalSk DateTime @map("tanggal_sk")
  tmtKgb    DateTime @map("tmt_kgb") // terhitung mulai tanggal

  golonganLama String @map("golongan_lama")
  golonganBaru String @map("golongan_baru")

  fileUrl String? @map("file_url")

  diajukanOlehId String @map("diajukan_oleh_id")
  diajukanOleh   User   @relation("SkKgbDiajukanOleh", fields: [diajukanOlehId], references: [id])

  // DIAJUKAN, DISETUJUI, DITOLAK
  status String @default("DIAJUKAN")

  appliedAt DateTime? @map("applied_at")
  appliedBy String?   @map("applied_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pegawaiId])
  @@index([status])
  @@map("sk_kgb")
}

// ---------------------------------------------------------------------------
// SK HUKUMAN DISIPLIN - input Kasubag TU, mempengaruhi perhitungan Tukin
// (Pasal 15 - lihat CLAUDE.md item open #2, BELUM diimplementasi di
// business-logic/tukin.ts).
//
// TODO(confirm) BESAR - INI ASUMSI, BUKAN KEPUTUSAN FINAL: alur approval SK
// hukuman disiplin di bawah ini (approval OSDMA, jenjang tunggal - pola
// SAMA dengan SK KGB) adalah ASUMSI dari spesifikasi simulasi, BUKAN
// konfirmasi resmi dari OSDMA/Biro Hukum. Alasan diberi alur approval OSDMA:
// (1) Pasal 15 soal potongan disiplin belum diimplementasi sama sekali di
// business logic engine, (2) data ini sensitif (menyangkut catatan disiplin
// pegawai). Desain skema/alur SIAP dipakai kalau asumsi ini benar, tapi
// WAJIB dikonfirmasi ke OSDMA/Biro Hukum dulu sebelum dipakai ke production.
//
// jenisHukuman SENGAJA free-text (bukan enum kaku) karena kategorisasi resmi
// tingkat hukuman disiplin (ringan/sedang/berat per PP 94/2021) belum
// dikonfirmasi pemetaannya ke sistem ini.
// ---------------------------------------------------------------------------
model SkHukumanDisiplin {
  id String @id @default(uuid())

  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  // NULLABLE sejak ada penanda `skBelumTerbit`: kalau SK-nya memang belum
  // terbit, tidak ada nomor yang bisa diisi - memaksa mengarang sesuatu di
  // sini justru menghasilkan data yang kelihatan resmi.
  nomorSk      String?  @map("nomor_sk")
  tanggalSk    DateTime @map("tanggal_sk")
  jenisHukuman String   @map("jenis_hukuman")
  keterangan   String?

  // Keputusan hukuman diproses pimpinan dan nomor SK-nya terbit BELAKANGAN,
  // sementara unit sudah perlu mencatat orangnya supaya tukin periode berjalan
  // tidak terlanjur dibayar dengan kelas jabatan lama.
  //
  // Sengaja kolom sendiri, BUKAN teks "(belum terbit)" di nomorSk: kolom bisa
  // di-query, jadi pertanyaan "SK mana saja yang sudah memotong tukin padahal
  // nomornya belum ada?" bisa dijawab pasti - dan itu pertanyaan yang wajib
  // bisa dijawab sebelum go-live. Teks bebas juga ikut tercetak apa adanya ke
  // daftar & laporan, gampang terbaca sebagai nomor yang sebenarnya.
  //
  // TIDAK menghalangi perhitungan: baris bertanda ini tetap berpengaruh ke
  // tarif SETELAH disetujui OSDMA, supaya alurnya bisa diuji utuh. Yang
  // dijamin cuma satu hal - keadaannya kelihatan di setiap layar tempat
  // manusia bisa mengambil keputusan atasnya.
  skBelumTerbit Boolean @default(false) @map("sk_belum_terbit")

  // Rentang periode kalkulasi Tukin yang terdampak potongan disiplin ini.
  // periodeSelesaiBulan/Tahun NULL berarti masih berlaku sampai dicabut.
  periodeMulaiBulan   Int  @map("periode_mulai_bulan")
  periodeMulaiTahun   Int  @map("periode_mulai_tahun")
  periodeSelesaiBulan Int? @map("periode_selesai_bulan")
  periodeSelesaiTahun Int? @map("periode_selesai_tahun")

  // Kelas jabatan yang BERLAKU selama masa hukuman (PP 94/2021 - penurunan
  // jabatan setingkat lebih rendah). Tarif tukin pokok ditentukan kelas
  // jabatan, jadi ini langsung mengubah yang dibayarkan.
  //
  // SIAP TIDAK mencatat penurunan ini sama sekali - dikonfirmasi user lewat
  // kasus nyata (Galih Febian Azhar, turun kelas 7 -> 6 selama 1 tahun; SIAP
  // tetap menulis 7). Jadi angka ini memang HARUS diisi manusia, dan itu bukan
  // kekurangan sementara yang akan hilang begitu integrasinya membaik.
  //
  // Disimpan ABSOLUT, bukan "turun berapa tingkat": kalau relatif, kelas dasar
  // yang keliru di SIAP ikut menggeser hasilnya tanpa ketahuan. Yang dipakai
  // membayar jadi sama persis dengan yang tertulis di SK.
  //
  // null = hukumannya tidak menurunkan kelas jabatan (mis. teguran lisan/
  // tertulis). Baris lama otomatis null, jadi perilakunya tidak berubah.
  kelasJabatanSelamaHukuman Int? @map("kelas_jabatan_selama_hukuman")

  fileUrl String? @map("file_url")

  diajukanOlehId String @map("diajukan_oleh_id")
  diajukanOleh   User   @relation("SkHukdisDiajukanOleh", fields: [diajukanOlehId], references: [id])

  // DIAJUKAN, DISETUJUI, DITOLAK
  status String @default("DIAJUKAN")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pegawaiId])
  @@index([status])
  @@map("sk_hukuman_disiplin")
}

// ---------------------------------------------------------------------------
// ANGGARAN REALISASI - upload PPABP, dasar dashboard "total Anggaran vs
// Realisasi" lintas unit. Satu baris = total pagu & realisasi belanja
// pegawai satu satuan kerja untuk satu periode (BELUM dipecah per jenis
// belanja/Tukin-UM-Lembur - lihat kebutuhan dashboard saat ini yang cuma
// minta total, bukan breakdown).
// ---------------------------------------------------------------------------
model AnggaranRealisasi {
  id String @id @default(uuid())

  satuanKerja  String @map("satuan_kerja")
  periodeBulan Int    @map("periode_bulan")
  periodeTahun Int    @map("periode_tahun")

  pagu      Float
  realisasi Float

  sourceFileUrl String? @map("source_file_url")

  diunggahOlehId String @map("diunggah_oleh_id")
  diunggahOleh   User   @relation(fields: [diunggahOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([satuanKerja, periodeBulan, periodeTahun])
  @@index([periodeBulan, periodeTahun])
  @@map("anggaran_realisasi")
}

// ---------------------------------------------------------------------------
// BUKTI POTONG PAJAK - hasil UPLOAD MANUAL oleh Kasubag TU/PPABP (diunduh
// dari Web Gaji dulu, BELUM ada koneksi API ke sistem Kemenkeu). Pegawai
// cuma bisa lihat/download, TIDAK BISA upload sendiri (lihat role matrix
// PEGAWAI di CLAUDE.md).
// ---------------------------------------------------------------------------
model BuktiPotongPajak {
  id String @id @default(uuid())

  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  tahunPajak       Int     @map("tahun_pajak")
  nomorBuktiPotong String? @map("nomor_bukti_potong")
  fileUrl          String  @map("file_url")

  diunggahOlehId String @map("diunggah_oleh_id")
  diunggahOleh   User   @relation(fields: [diunggahOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pegawaiId, tahunPajak])
  @@map("bukti_potong_pajak")
}

// ---------------------------------------------------------------------------
// USULAN PERUBAHAN ROLE - PPABP bisa MELIHAT & MENGUSULKAN perubahan role
// user (Pegawai/Kasubag TU/OSDMA/PPABP/Pimpinan), TAPI eksekusi final ada
// di ADMIN (role matrix, poin 4 & 6) - supaya tidak ada dua pihak yang
// sama-sama bisa eksekusi langsung dan berpotensi konflik. Baris ini BUKAN
// approval berjenjang (beda dengan ApprovalLog) - cuma usul (oleh PPABP) lalu
// keputusan tunggal (oleh ADMIN): eksekusi atau tolak.
// ---------------------------------------------------------------------------
model UsulanPerubahanRole {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  roleSaatIni   Role    @map("role_saat_ini") // snapshot waktu diusulkan
  roleDiusulkan Role    @map("role_diusulkan")
  alasan        String?

  diusulkanOlehId String @map("diusulkan_oleh_id")
  diusulkanOleh   User   @relation("UsulanRoleDiajukanOleh", fields: [diusulkanOlehId], references: [id])

  // MENUNGGU, DIEKSEKUSI, DITOLAK
  status String @default("MENUNGGU")

  diputuskanOlehId String?   @map("diputuskan_oleh_id")
  diputuskanOleh   User?     @relation("UsulanRoleDiputuskanOleh", fields: [diputuskanOlehId], references: [id])
  diputuskanPada   DateTime? @map("diputuskan_pada")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("usulan_perubahan_role")
}

// ---------------------------------------------------------------------------
// GAJI INDUK - komponen gaji pokok & tunjangan melekat, hasil UPLOAD MANUAL
// oleh PPABP dari file ADK "Gaji_Bank_<kdsatker><...>.xlsx" yang di-generate
// aplikasi GPP/Web Gaji Kemenkeu. BUKAN hasil kalkulasi Gajihub - sistem ini
// TIDAK menghitung gaji pokok/tunjangan keluarga (itu domain Web Gaji, sesuai
// prinsip "don't replace, integrate" di CLAUDE.md). Gajihub cuma MENAMPUNG
// hasilnya supaya slip gaji pegawai bisa utuh (gaji induk + tukin + uang
// makan + uang lembur), persis format "PERINCIAN PEMBAYARAN GAJI" yang
// sekarang dicetak manual oleh PPABP Setjen.
//
// Nama kolom di sini SENGAJA pakai istilah slip gaji (bahasa Indonesia),
// BUKAN nama kolom mentah GPP (gjpokok/tjistri/potpfk10/dst) - pemetaannya
// ada di src/business-logic/gajiInduk.ts, satu tempat, biar gampang dicek
// ulang kalau format file GPP berubah.
//
// TODO(confirm):
// - Kolom yang SENGAJA TIDAK diimpor dari file GPP: npwp, nmrek, nm_bank,
//   rekening, kdbankspan, nmbankspan, kdpos. Itu PII finansial yang tidak
//   dibutuhkan slip gaji - konsisten dengan keputusan yang sama di
//   src/jobs/importPegawaiXlsx.ts. Kalau nanti kolom rekening di export ADK
//   Tukin (src/app/ppabp/adk/tukin/route.ts) mau diisi, itu keputusan
//   TERPISAH soal menyimpan data rekening, bukan efek samping fitur ini.
// - Baru mendukung gaji INDUK (kdjns = 1 di file GPP). Gaji susulan/
//   kekurangan/terusan (jenis lain) belum ditangani - unique constraint di
//   bawah menganggap satu pegawai cuma punya SATU baris gaji per periode.
//   Kalau nanti perlu, `jenisGaji` harus ikut masuk unique key (migrasi baru).
// - `honorarium` TIDAK ADA di file GPP (di slip contoh nilainya Rp 11,4 jt).
//   Sengaja dibiarkan 0 setelah upload dan diisi/di-edit manual oleh PPABP
//   lewat /ppabp/gaji-induk. Sumber resminya belum jelas (kemungkinan dari
//   SPJ kegiatan, bukan dari GPP) - jangan diasumsikan bisa ditarik otomatis.
// ---------------------------------------------------------------------------
model GajiInduk {
  id        String  @id @default(uuid())
  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  periodeBulan Int @map("periode_bulan")
  periodeTahun Int @map("periode_tahun")

  // Jejak asal data - dipakai buat menjelaskan ke pegawai/auditor baris ini
  // datang dari file GPP yang mana. `kodeSatker` juga satu-satunya sumber
  // kode satker resmi (mis. 450938) yang dipunya sistem ini sekarang.
  kodeSatker String? @map("kode_satker")
  nomorGaji  String? @map("nomor_gaji") // kolom `nogaji`, mis. "000964"
  jenisGaji  String  @default("1") @map("jenis_gaji") // kolom `kdjns`, 1 = gaji induk

  // --- PENGHASILAN (urutan sama dengan slip) ---
  gajiPokok           Float @map("gaji_pokok")
  tunjanganIstri      Float @default(0) @map("tunjangan_istri")
  tunjanganAnak       Float @default(0) @map("tunjangan_anak")
  tunjanganUmum       Float @default(0) @map("tunjangan_umum") // `tjupns`
  tunjanganStruktural Float @default(0) @map("tunjangan_struktural") // `tjstruk`
  tunjanganFungsional Float @default(0) @map("tunjangan_fungsional")
  tunjanganBeras      Float @default(0) @map("tunjangan_beras")
  tunjanganPph        Float @default(0) @map("tunjangan_pph")
  pembulatan          Float @default(0)
  // Gabungan tjdaerah + tjpencil + tjlain + tjkompen. Di file contoh Setjen
  // keempatnya nol semua, tapi tetap ditampung supaya tidak diam-diam hilang
  // kalau satker lain punya isinya.
  tunjanganLain       Float @default(0) @map("tunjangan_lain")

  // --- POTONGAN ---
  potonganIuranPegawai Float @default(0) @map("potongan_iuran_pegawai") // `potpfk10`, 8% x (gapok + tj istri + tj anak)
  potonganPph          Float @default(0) @map("potongan_pph")
  potonganBpjs         Float @default(0) @map("potongan_bpjs") // `bpjs` + `bpjs2`
  potonganLain         Float @default(0) @map("potongan_lain") // potswrum + potkelbtj + potlain + pottabrum + potpfkbul + potpfk2

  // --- TOTAL ---
  // Disimpan (bukan cuma dihitung on-the-fly) supaya angka di slip bisa
  // ditelusuri persis ke nilai yang di-upload, walau nanti rumus tampilannya
  // berubah. `gajiBersih` diambil APA ADANYA dari kolom `bersih` file GPP -
  // bukan hasil hitungan sendiri, biar tetap otoritatif ke sumbernya.
  totalPenghasilan Float @map("total_penghasilan")
  totalPotongan    Float @map("total_potongan")
  gajiBersih       Float @map("gaji_bersih")

  // BUKAN dari file GPP - diisi manual PPABP (lihat TODO(confirm) di atas).
  honorarium Float @default(0)

  sourceFileName String?  @map("source_file_name")
  diunggahOlehId String   @map("diunggah_oleh_id")
  diunggahOleh   User     @relation(fields: [diunggahOlehId], references: [id])
  diunggahPada   DateTime @default(now()) @map("diunggah_pada")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([pegawaiId, periodeBulan, periodeTahun])
  @@index([periodeBulan, periodeTahun])
  @@map("gaji_induk")
}

// ---------------------------------------------------------------------------
// REKAP PRESENSI PERIODE - hasil UPLOAD MANUAL rekap kehadiran bulanan,
// sumber komponen 30% kehadiran Tukin.
//
// KENAPA tabel sendiri, bukan menulis ke PresensiHarian: yang di-upload adalah
// REKAP BULANAN (total hari alpha, total menit terlambat, dst), bukan catatan
// per hari. Memecahnya jadi baris harian palsu berarti mengarang tanggal
// kejadian yang tidak ada di sumbernya.
//
// Dua jalur data hidup berdampingan, dan itu disengaja:
// - PresensiHarian : diisi sinkronisasi e-Presensi (per hari, detail)
// - RekapPresensiPeriode : diisi upload manual (per bulan, agregat)
// Kalkulasi Tukin memakai rekap ini kalau ada; kalau tidak ada, dihitung dari
// PresensiHarian. Ini sejalan dengan Pasal 23 Permenaker 15/2024 yang memang
// mengakui penghitungan manual selama sistem informasi belum berjalan.
//
// TODO(confirm): belum ada aturan mana yang menang kalau KEDUANYA terisi untuk
// periode yang sama. Sekarang rekap manual yang dipakai (asumsi: kalau orang
// sampai meng-upload manual, itu koreksi atas data otomatis). Perlu
// dikonfirmasi begitu e-Presensi benar-benar tersambung.
// ---------------------------------------------------------------------------
model RekapPresensiPeriode {
  id        String  @id @default(uuid())
  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  periodeBulan Int @map("periode_bulan")
  periodeTahun Int @map("periode_tahun")

  // Enam field pertama memetakan LANGSUNG ke tabel potongan Pasal 13.
  jumlahHariAlpha              Int @default(0) @map("jumlah_hari_alpha") // ayat (1) - 3%/hari
  jumlahTidakPresensi          Int @default(0) @map("jumlah_tidak_presensi") // ayat (2) - 1%/kejadian
  totalMenitTerlambat          Int @default(0) @map("total_menit_terlambat") // ayat (3) - 0,01%/menit
  totalMenitPulangCepat        Int @default(0) @map("total_menit_pulang_cepat") // ayat (3)
  totalMenitMeninggalkanKantor Int @default(0) @map("total_menit_meninggalkan_kantor") // ayat (3)
  // Kolom `total_menit_kekurangan_jam_kerja` DIHAPUS 2026-08-07 (migrasi
  // 20260807000000_cabut_kekurangan_jam_kerja). Ditambahkan 2026-08-06 sebagai
  // pelanggaran keempat bertarif per menit, lalu dicabut setelah teks pasalnya
  // dibaca: Pasal 13 ayat (3) menyebut TEPAT TIGA - "terlambat hadir, pulang
  // cepat, atau meninggalkan kantor" - dan Pasal 12 huruf c yang dirujuknya
  // menyebut tiga hal yang sama. Saat dicabut, 0 dari 40.740 baris berisi
  // nilai bukan 0, jadi tidak ada angka yang pernah dihitung yang berubah.
  jumlahTidakIkutUpacara       Int @default(0) @map("jumlah_tidak_ikut_upacara") // ayat (4) - 3%/kejadian

  // --- Dipakai UANG MAKAN (SBM 2026 item 22.1), BUKAN potongan Tukin ---
  // Dipecah per status karena tidak semua kehadiran berhak uang makan:
  // WFO & WFH/WFA berhak, Diklat & Dinas Keluar TIDAK. Kolom diklat & dinas
  // luar disimpan walau tidak dibayar - supaya selisih antara "hari hadir"
  // dan "hari dibayar" bisa dijelaskan, bukan hilang begitu saja.
  jumlahHariKerja        Int @default(0) @map("jumlah_hari_kerja")
  jumlahHariHadir        Int @default(0) @map("jumlah_hari_hadir")
  jumlahHariWfo          Int @default(0) @map("jumlah_hari_wfo")
  jumlahHariWfhWfa       Int @default(0) @map("jumlah_hari_wfh_wfa")
  jumlahHariDiklat       Int @default(0) @map("jumlah_hari_diklat")
  jumlahHariDinasLuar    Int @default(0) @map("jumlah_hari_dinas_luar")
  // Hari berstatus "Tugas Belajar". BUKAN untuk uang makan - ini penanda
  // bahwa Tunjangan Kinerja periode ini dibayar 80% (Permenaker 15/2024).
  jumlahHariTugasBelajar Int @default(0) @map("jumlah_hari_tugas_belajar")

  // --- Dipakai UANG LEMBUR (SBM 2026 item 23.1 & 23.2) ---
  // Dua angka, karena dua komponennya beda satuan: uang lembur per JAM,
  // uang makan lembur per HARI (syarat lembur >= 2 jam pada hari itu).
  // Total jam saja TIDAK cukup buat menurunkan jumlah harinya.
  // Dipisah hari kerja vs hari libur/tanggal merah: tarif per jam di hari
  // libur dikali PENGALI_LEMBUR_HARI_LIBUR (lihat tarifSbm.ts - pengali itu
  // BUKAN dari SBM, belum ada rujukan pasalnya).
  // CATATAN PENGISIAN: jam lembur di sini HARUS sudah mengecualikan hari
  // WFH/WFA - pegawai yang bekerja dari rumah tidak dihitung lembur walau
  // jam absen keluarnya melewati jam kerja.
  // --- CUTI (Pasal 14) ---
  // Disimpan sebagai TIGA kolom, bukan satu kolom per jenis cuti seperti di
  // rekap Excel manual (yang punya 12 kolom cuti). Alasannya: bentuk inilah
  // yang dikonsumsi engine (`cutiAktif` di RekapKehadiranPeriode), dan 12
  // kolom Excel itu bisa diturunkan darinya - sementara sebaliknya tidak bisa,
  // karena "Cuti Sakit Bulan II" tidak memberi tahu berapa harinya.
  //
  // KETERBATASAN YANG DISENGAJA: satu pegawai cuma bisa punya SATU jenis cuti
  // per periode, mengikuti bentuk `cutiAktif` yang memang tunggal. Kalau nanti
  // ada kasus dua jenis cuti dalam satu bulan, ini perlu jadi tabel sendiri.
  //
  // jenisCutiAktif memakai nilai JenisCuti (src/types/index.ts), mis.
  // "CUTI_SAKIT". null = tidak sedang cuti.
  jenisCutiAktif    String? @map("jenis_cuti_aktif")
  // Bulan KE BERAPA cuti berjalan (1, 2, 3, ...) - penentu tarif potongan
  // untuk cuti sakit & cuti besar. TIDAK bisa diturunkan dari data presensi
  // satu bulan, jadi harus diisi manual lewat template.
  bulanCutiKeberapa Int?    @map("bulan_cuti_keberapa")
  // Jumlah HARI cuti dalam periode ini. Dipakai KHUSUS oleh cuti sakit gugur
  // kandungan yang tarifnya 1% per hari (Pasal 14 huruf e).
  jumlahHariCuti    Int     @default(0) @map("jumlah_hari_cuti")

  totalJamLembur                 Float @default(0) @map("total_jam_lembur")
  totalJamLemburHariLibur        Float @default(0) @map("total_jam_lembur_hari_libur")
  jumlahHariMakanLembur          Int   @default(0) @map("jumlah_hari_makan_lembur")
  jumlahHariMakanLemburHariLibur Int   @default(0) @map("jumlah_hari_makan_lembur_hari_libur")

  sourceSystem   String   @default("UPLOAD_MANUAL") @map("source_system")
  sourceFileName String?  @map("source_file_name")
  diunggahOlehId String   @map("diunggah_oleh_id")
  diunggahOleh   User     @relation(fields: [diunggahOlehId], references: [id])
  diunggahPada   DateTime @default(now()) @map("diunggah_pada")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([pegawaiId, periodeBulan, periodeTahun])
  @@index([periodeBulan, periodeTahun])
  @@map("rekap_presensi_periode")
}

// ---------------------------------------------------------------------------
// Tanggal e-Presensi bermasalah (Pasal 10 ayat (2) Permenaker 15/2024).
//
// "Dalam hal presensi elektronik mengalami kendala atau keadaan kahar,
//  presensi dilakukan secara manual yang diketahui oleh pimpinan Unit Kerja
//  masing-masing."
//
// KENAPA TABEL SENDIRI, bukan mengoreksi presensi orang per orang: kalau
// e-Presensi tidak bisa diakses, yang rusak adalah TANGGALNYA, bukan
// kedisiplinan 960 orang. Dicatat sebagai satu fakta tentang tanggal itu,
// lalu berlaku ke semua yang terdampak - sekali putus, bukan 960 kali ketik.
//
// Kejadian nyata yang melahirkannya: 15 & 16 Juli 2026, angka "jam keluar
// 23:59" (isian otomatis e-Presensi saat absen pulang tidak pernah masuk)
// melonjak jadi 13,6% dan 14,1% dari hari kerja, sementara hari biasa cuma
// 1,3-2,5%. 1.173 kejadian, 960 pegawai, senilai Rp 18.178.588 potongan
// Pasal 13 ayat (2). Sebelum ada tabel ini, satu-satunya cara memperbaikinya
// adalah PPABP mengetik ulang jam pulang orang per orang - dan itu hanya
// terjadi untuk yang kebetulan melapor beserta foto bergeotag. Yang tidak
// tahu harus melapor tetap dipotong untuk kerusakan yang bukan miliknya.
//
// DATA MENTAH TIDAK DITIMPA. Jam 23:59 tetap tersimpan apa adanya di
// PresensiHarian; pengecualian ini ditumpuk di atasnya saat rekap dihitung,
// jadi auditor tetap bisa melihat keduanya - apa yang tercatat, dan atas
// dasar apa dikecualikan.
model KendalaEpresensi {
  id String @id @default(uuid())

  /// Tanggal kejadian, disimpan tengah malam UTC (konvensi yang sama dengan
  /// PresensiHarian.tanggal) supaya tidak bergeser hari.
  tanggal DateTime

  /// NULL = berlaku seluruh kementerian. Diisi kalau kendalanya cuma menimpa
  /// satu satuan kerja (mis. jaringan satu balai putus).
  satuanKerja String? @map("satuan_kerja")

  /// WAJIB. Ini yang dibaca auditor ketika bertanya kenapa potongan sehari
  /// hilang untuk ratusan orang - jadi tidak boleh kosong.
  alasan String

  ditandaiOlehId String   @map("ditandai_oleh_id")
  ditandaiOleh   User     @relation(fields: [ditandaiOlehId], references: [id])
  ditandaiPada   DateTime @default(now()) @map("ditandai_pada")

  // Satu tanggal cuma boleh punya satu penanda per cakupan. Catatan: Postgres
  // memperlakukan NULL sebagai tidak-sama-dengan-apa pun di unique index,
  // jadi penanda se-kementerian (satuanKerja NULL) TIDAK tertangkap constraint
  // ini - dicek eksplisit di action-nya.
  @@unique([tanggal, satuanKerja])
  @@index([tanggal])
  @@map("kendala_epresensi")
}

// ---------------------------------------------------------------------------
// Koreksi jam presensi SATU pegawai SATU hari - lanjutan Pasal 10 ayat (2).
//
// ALUR NYATANYA (keterangan user): e-Presensi error -> pegawai memotret
// dirinya beserta geotag & jam -> dikirim ke WhatsApp petugas absensi ->
// petugas memperbaiki jamnya di Gajihub. Tabel ini tempat perbaikan itu.
//
// KENAPA TABEL SENDIRI, BUKAN MENIMPA `PresensiHarian`:
// sinkronisasi e-Presensi MENGHAPUS sebulan penuh lalu menulis ulang
// (`simpanRekapPresensi.ts`). Jam hasil koreksi yang ditulis langsung ke
// PresensiHarian akan HILANG pada tarikan berikutnya - persis masalah yang
// dulu memaksa `kelasJabatanSelamaHukuman` punya kolom sendiri daripada
// mengoreksi `Pegawai.kelasJabatan` yang ditimpa `sync:pegawai`.
//
// Konsekuensi yang disengaja: data mentah e-Presensi tetap utuh apa adanya
// (jam 23:59 tetap tersimpan), koreksinya ditumpuk di atasnya saat rekap
// dihitung. Auditor bisa melihat keduanya - apa yang dicatat mesin, dan apa
// yang diperbaiki manusia beserta alasannya.
//
// `jamMasuk`/`jamKeluar` NULLABLE dan artinya "tidak dikoreksi": petugas
// boleh memperbaiki jam pulang saja tanpa menyentuh jam masuk yang sudah
// benar. Keduanya null = baris tanpa arti, ditolak action-nya.
model KoreksiPresensiHarian {
  id String @id @default(uuid())

  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  /// Tengah malam UTC - konvensi yang sama dengan PresensiHarian.tanggal.
  tanggal DateTime

  /// null = biarkan jam dari e-Presensi apa adanya.
  jamMasuk  DateTime? @map("jam_masuk")
  jamKeluar DateTime? @map("jam_keluar")

  /// WAJIB. Berisi dasar koreksinya - siapa yang melapor, lewat apa, bukti
  /// apa yang dipegang. Foto & geotag-nya sendiri TIDAK disimpan di sini
  /// (kebijakan penyimpanan dokumen masih terbuka, lihat TODO(confirm)
  /// storage di CLAUDE.md); yang dicatat sistem adalah keputusannya.
  alasan String

  dikoreksiOlehId String   @map("dikoreksi_oleh_id")
  dikoreksiOleh   User     @relation(fields: [dikoreksiOlehId], references: [id])
  dikoreksiPada   DateTime @default(now()) @map("dikoreksi_pada")

  @@unique([pegawaiId, tanggal])
  @@index([tanggal])
  @@map("koreksi_presensi_harian")
}

// ---------------------------------------------------------------------------
// REKENING PEGAWAI - data rekening bank penerima pembayaran.
//
// KENAPA per JENIS PEMBAYARAN, bukan satu rekening per pegawai: sudah
// dibuktikan dari dua file asli satker 450938 periode 06/2026 bahwa tukin dan
// gaji dibayarkan lewat BANK YANG BERBEDA -
//   gaji  : BNI, kode bank SPAN 520009000990
//   tukin : BRI, kode bank SPAN 520002000990
// dan dari 96 NIP yang ada di kedua file, TIDAK ADA SATUPUN yang nomor
// rekeningnya sama. Jadi rekening tukin TIDAK BISA diturunkan dari file gaji
// induk GPP, dan sebaliknya.
//
// CATATAN PII: ini data rekening bank - PII finansial. Sebelumnya kolom
// rekening SENGAJA dibuang saat parsing file gaji GPP. Keputusan itu DICABUT
// atas permintaan user (2026-07-29) karena Web Gaji Kemenkeu memang butuh
// nomor rekening untuk memproses pembayaran, dan SAKTI SPP memprosesnya per
// bank. Konsekuensinya: database ini sekarang menyimpan rekening bank ±ribuan
// pegawai, sementara aplikasinya masih jalan di HTTP dengan password = NIP
// (lihat TODO(legal-confirm) di src/auth/session.ts). WAJIB diamankan sebelum
// dibuka ke jaringan yang lebih luas - ini menaikkan taruhannya secara nyata.
// ---------------------------------------------------------------------------
model RekeningPegawai {
  id        String  @id @default(uuid())
  pegawaiId String  @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  // TUKIN atau GAJI - jenis pembayaran yang memakai rekening ini.| GAJI - jenis pembayaran yang memakai rekening ini. */
  jenisPembayaran String @map("jenis_pembayaran")

  kodeBankSpan  String  @map("kode_bank_span") // mis. "520002000990"
  namaBank      String  @map("nama_bank")
  nomorRekening String  @map("nomor_rekening")
  // Nama pemilik rekening - sering beda penulisan dari Pegawai.nama.
  namaRekening  String? @map("nama_rekening")

  sourceFileName String?  @map("source_file_name")
  diunggahOlehId String   @map("diunggah_oleh_id")
  diunggahOleh   User     @relation(fields: [diunggahOlehId], references: [id])
  diunggahPada   DateTime @default(now()) @map("diunggah_pada")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([pegawaiId, jenisPembayaran])
  @@index([jenisPembayaran, kodeBankSpan])
  @@map("rekening_pegawai")
}

/// Identitas pembayaran pegawai menurut WEB GAJI KEMENKEU - sumber terpisah
/// dari `Pegawai` (yang merupakan cermin SIAP).
///
/// KENAPA TABEL SENDIRI, bukan kolom tambahan di `Pegawai`:
///   1. `Pegawai` DITIMPA ULANG tiap `npm run sync:pegawai` (upsert dengan
///      `nama` ikut di-update). Nama versi Web Gaji akan hilang tiap sync.
///   2. Sumber & kewenangannya beda. SIAP sah untuk kepegawaian; Web Gaji
///      Kemenkeu sah untuk pembayaran. Keduanya benar di ranahnya
///      masing-masing dan tidak boleh saling menimpa - terukur BEDA pada
///      3.628 dari 4.701 pegawai (77%), umumnya karena gelar.
///   3. Cakupannya beda. File Web Gaji tidak memuat semua pegawai aktif, dan
///      memuat NIP yang tidak ada di SIAP. Menyatukannya berarti salah satu
///      sisi harus dikosongkan paksa.
///
/// Rekening bank SENGAJA TIDAK ditaruh di sini - itu tetap di
/// `RekeningPegawai`, yang sudah dipakai pemisahan berkas ADK per bank. Satu
/// unggahan mengisi KEDUA tabel. Dua tabel rekening berarti dua kebenaran,
/// dan cepat atau lambat keduanya berbeda.
model IdentitasWebGaji {
  id        String  @id @default(uuid())
  pegawaiId String  @unique @map("pegawai_id")
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id])

  /// Nama sesuai penulisan Web Gaji Kemenkeu. INI yang dipakai di berkas ADK.
  nama String

  /// "PNS" / "PPPK" apa adanya dari file - TIDAK dipetakan ke enum, karena
  /// belum ada kebutuhan yang memakainya sebagai kondisi perhitungan.
  jenisPegawai String? @map("jenis_pegawai")

  /// Kode satker versi Kemenkeu (mis. "259031"). Sumber kedua setelah
  /// `GajiInduk.kodeSatker` - bedanya yang ini berlaku per PEGAWAI dan tidak
  /// terikat periode, jadi tetap ada walau gaji induk periode itu belum
  /// diunggah.
  kodeSatker      String? @map("kode_satker")
  namaSatuanKerja String? @map("nama_satuan_kerja")

  sourceFileName String?  @map("source_file_name")
  diunggahOlehId String   @map("diunggah_oleh_id")
  diunggahOleh   User     @relation(fields: [diunggahOlehId], references: [id])
  diunggahPada   DateTime @default(now()) @map("diunggah_pada")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([kodeSatker])
  @@map("identitas_web_gaji")
}

// ============================================================================
// HARI LIBUR NASIONAL - tanggal merah & cuti bersama
//
// KENAPA HARUS ADA TABELNYA. Sampai sebelum ini, "hari libur" di mesin rekap
// diturunkan HANYA dari Sabtu/Minggu (JADWAL_KERJA_DEFAULT.jamPulangWajibMenit
// bernilai null di kedua hari itu). Tanggal merah yang jatuh di hari kerja
// terbaca sebagai hari kerja biasa, dan itu salah di TIGA tempat sekaligus:
//
//   1. Lembur di tanggal itu dibayar tarif 1x, seharusnya 2x (hari libur).
//      Terukur di data: Juni 2026 ada 12 baris lembur pada 1 Juni (Hari Lahir
//      Pancasila) dan 7 baris pada 16 Juni (Tahun Baru Islam) - 19 baris
//      dibayar setengah dari yang seharusnya.
//   2. Hari itu ikut terhitung `jumlahHariKerja`, yang jadi BATAS ATAS jumlah
//      hari uang makan (Math.min di uangMakan.ts).
//   3. Potongan Pasal 13 tetap berlaku, padahal tidak ada kewajiban jam kerja
//      yang bisa dilanggar.
//
// KENAPA TIDAK DIAMBIL DARI e-PRESENSI: tabel `libur` di sana ADA tapi KOSONG
// (sudah dicek). Jadi tidak ada sumber yang bisa ditarik otomatis.
//
// KENAPA TIDAK DIHARDCODE DI KODE: tanggal merah ditetapkan SKB 3 Menteri tiap
// tahun dan sering direvisi (cuti bersama tambahan/dibatalkan). Menaruhnya di
// kode berarti setiap revisi butuh deploy, dan tanggal tahun depan tidak bisa
// diisi tanpa menyentuh kode.
//
// `cutiBersama` dipisah dari libur biasa BUKAN untuk perlakuan pembayaran
// (keduanya sama-sama hari libur), tapi supaya bisa dilaporkan terpisah -
// cuti bersama memotong jatah cuti tahunan pegawai, libur nasional tidak.
// ============================================================================
model HariLiburNasional {
  id String @id @default(uuid())

  /// Disimpan tengah malam UTC, konvensi yang sama dengan PresensiHarian
  /// supaya perbandingan tanggal tidak bergeser hari.
  tanggal DateTime @unique

  /// WAJIB. Nama harinya ("Hari Raya Idul Fitri", "Cuti Bersama Idul Fitri") -
  /// ini yang muncul di catatan hasil rekap, jadi harus bisa dibaca manusia.
  keterangan String

  /// true = cuti bersama (memotong jatah cuti tahunan), false = libur nasional.
  cutiBersama Boolean @default(false)

  ditetapkanOlehId String   @map("ditetapkan_oleh_id")
  ditetapkanOleh   User     @relation(fields: [ditetapkanOlehId], references: [id])
  ditetapkanPada   DateTime @default(now()) @map("ditetapkan_pada")

  @@index([tanggal])
  @@map("hari_libur_nasional")
}
